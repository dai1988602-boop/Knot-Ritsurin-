# Beds24 API v2
# セットアップ手順: https://wiki.beds24.com/index.php/Category:API_V2
# 1. Beds24管理画面でinvite codeを発行する
# 2. GET {BEDS24_BASE_URL}/authentication/setup にinvite codeを渡し、refreshTokenを取得する(初回のみ・手動作業)
# 3. 取得したrefreshTokenを下記に設定する(以降はこのrefreshTokenからaccess tokenを自動取得する)
BEDS24_BASE_URL=https://beds24.com/api/v2
BEDS24_REFRESH_TOKEN=

# PriceLabs Customer API
# 取得手順: PriceLabs管理画面 > Account Settings > API Details > Get PriceLabs API Key
PRICELABS_BASE_URL=https://api.pricelabs.co/v1
PRICELABS_API_KEY=

# 通知先 (Discord)
# 承認依頼・実行結果・エラー通知の送信先。Discordサーバーのチャンネル設定から
# Webhook URLを発行して設定する。(notifications/discord.py は未実装)
DISCORD_WEBHOOK_URL=
